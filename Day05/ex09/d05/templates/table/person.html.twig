<!DOCTYPE html>
<html>
    <head>
<style>
table, th, td, caption {
  border: 1px solid black;
}
</style>

    </head>
    <body>

<a href="/add_column">Add column</a>
<table>
    <thead>
        <tr>
            {% for column in columns %}
                <th>{{ column }}</th>
            {% endfor %}
        </tr>
    </thead>

    <tbody>
        {% for person in persons %}
            <tr>
                {% for column in columns %}
                    <td>{{ attribute(person, column) }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
    </tbody>
</table>


<a href="/person">Back to form</a>


</body>
</html>
